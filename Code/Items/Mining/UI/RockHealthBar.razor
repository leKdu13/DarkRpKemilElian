@using Sandbox;
@using Sandbox.UI;
@namespace Sandbox
@inherits PanelComponent

<root>
    <div class="health-bar-container">
        <div class="health-bar-fill" style="width: @(GetHealthPercent())%"></div>
        <label>@(TargetRock?.RockType.ToString()) - @(MathX.CeilToInt(TargetRock?.Health ?? 0)) HP</label>
    </div>
</root>

@code {
    [Property] public ChoppableRock TargetRock { get; set; }

    private float GetHealthPercent()
    {
        if (TargetRock == null || TargetRock.MaxHealth <= 0) return 0f;
        return (TargetRock.Health / TargetRock.MaxHealth) * 100f;
    }

    protected override int BuildHash() => System.HashCode.Combine(TargetRock?.Health, TargetRock?.MaxHealth, TargetRock?.RockType);
}

<style>
RockHealthBar {
    width: 300px;
    height: 50px;
    background-color: rgba( 0, 0, 0, 0.8 );
    border-radius: 8px;
    border: 2px solid white;
    justify-content: center;
    align-items: center;
    font-family: Poppins, sans-serif;
    font-size: 24px;
    font-weight: bold;
    color: white;
    position: relative;
    overflow: hidden;

    .health-bar-container {
        width: 100%;
        height: 100%;
        position: relative;
    }

    .health-bar-fill {
        position: absolute;
        left: 0;
        top: 0;
        height: 100%;
        background-color: #e74c3c;
        transition: width 0.2s ease;
    }

    label {
        position: absolute;
        width: 100%;
        height: 100%;
        text-align: center;
        align-content: center;
        text-shadow: 2px 2px 4px black;
    }
}
</style>
